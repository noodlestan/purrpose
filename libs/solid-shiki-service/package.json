{
  "name": "@purrpose/solid-shiki-service",
  "version": "0.0.13",
  "description": "Shiki syntax highlighting service for SolidJS.",
  "keywords": [
    "library",
    "shiki",
    "syntax-highlighting",
    "solidjs"
  ],
  "author": "Noodlestan Collective",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/purrpose.git",
    "directory": "libs/solid-shiki-service"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE-MIT",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "scripts": {
    "dev": "vite build --watch",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build": "vite build",
    "build:clean": "rm -rf dist",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run build && npm run test:ci"
  },
  "dependencies": {
    "@no-comply/solid-primitives": "0.0.12"
  },
  "peerDependencies": {
    "prettier": "^3.9.10",
    "shiki": "^4.3.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "vite-plugin-solid": "2.11.14",
    "vite-plugin-solid-svg": "0.8.1"
  }
}
