{
  "name": "@purrpose/solid-shiki-service",
  "version": "0.0.11",
  "description": "Shiki syntax highlighting service for SolidJS.",
  "author": "Noodlestan Collective",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/purrpose.git",
    "directory": "libs/solid-shiki-service"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "files": [
    "src",
    "LICENSE-MIT"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build": "vite build",
    "build:clean": "rm -rf dist",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run build && npm run test:ci"
  },
  "dependencies": {
    "@no-comply/solid-primitives": "0.0.11"
  },
  "peerDependencies": {
    "prettier": "^3.8.4",
    "shiki": "^4.3.0",
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "vite-plugin-solid": "2.11.12",
    "vite-plugin-solid-svg": "0.8.1"
  }
}
