    "build": "vite build",
    "build:clean": "rm -rf dist",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run build && npm run test:ci"
  },
  "dependencies": {},
  "peerDependencies": {
    "@purrpose/client-babel": "^0.0.11",
    "babel-plugin-jsx-dom-expressions": "^0.40.7",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {}
}
