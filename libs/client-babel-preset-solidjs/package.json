{
  "name": "@purrpose/client-babel-preset-solidjs",
  "version": "0.0.11",
  "description": "SolidJS JSX transform preset for `@purrpose/client-babel`.",
  "keywords": [
    "library",
    "jsx",
    "babel",
    "solidjs"
  ],
  "author": "Noodlestan Collective",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/purrpose.git",
    "directory": "libs/client-babel-preset-solidjs"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE-MIT",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "scripts": {
    "dev": "vite build --watch",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
