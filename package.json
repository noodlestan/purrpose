{
  "name": "purrpose",
  "version": "0.0.11",
  "description": "Single-purpose utilities for in-browser transformations: JSX/TSX compilation, SolidJS JSX transform presets, and Shiki-based syntax highlighting.",
  "keywords": [
    "solidjs"
  ],
  "author": "Noodlestan Collective",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/purrpose.git"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.2.3",
  "workspaces": [
    "libs/*"
  ],
  "prettier": "@noodlestan/prettier-config",
  "scripts": {
    "turbo": "turbo",
    "dev": "turbo run dev --ui tui",
    "clean": "turbo run build:clean",
    "lint": "prettier . -c",
    "lint:fix": "prettier . -c --write",
    "extract": "turbo run extract",
    "ci:root": "npm run lint",
    "ci": "npm run ci:root && turbo run ci"
  },
  "devDependencies": {
    "@noodlestan/conventions-typescript": "0.1.0",
    "@noodlestan/conventions-unit-tests": "0.1.0",
    "@noodlestan/eslint-config": "0.0.9",
    "@noodlestan/prettier-config": "0.1.1",
    "@noodlestan/tsconfig": "0.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "8.57.1",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
